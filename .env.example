PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# IMPORTANT: value must start with mongodb:// or mongodb+srv:// and should not include `MONGO_URI=` prefix inside the value.
JWT_SECRET=change_me_please
JWT_EXPIRES_IN=30d
# TV ekran akkaunti tokeni muddati (ekran o'zidan chiqib ketmasligi uchun).
JWT_TV_EXPIRES_IN=365d
# Hosting oldidagi proxy qatlamlari soni (Render uchun 1).
TRUST_PROXY_HOPS=1
SEED_DEFAULT_USERS=true
DEFAULT_PASSWORD=1234
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://sampi-medline.vercel.app
ALLOW_VERCEL_ORIGINS=false
VERCEL_ALLOWED_ORIGINS=
ENABLE_MAINTENANCE_ROUTES=false
MAINTENANCE_TOKEN=
